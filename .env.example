# Application Settings
APP_NAME=WhatsApp Sender Bot Pro
APP_VERSION=2.0.0
APP_ENV=production

# Database
DATABASE_URL=sqlite:///data/whatsapp_bot.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
SESSION_TIMEOUT=3600

# WhatsApp Settings
WHATSAPP_DEFAULT_COUNTRY_CODE=+972
WHATSAPP_QR_TIMEOUT=120
WHATSAPP_MESSAGE_TIMEOUT=20

# Browser Settings
DEFAULT_BROWSER=chrome
BROWSER_HEADLESS=false
BROWSER_DETACH=true

# Delays & Anti-Detection
MIN_DELAY=5
MAX_DELAY=10
PAUSE_AFTER=100
PAUSE_DURATION=120
TYPING_SPEED_MIN=0.05
TYPING_SPEED_MAX=0.15

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# API Settings (Optional)
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-api-key-here

# Encryption
ENCRYPT_LOGS=true
ENCRYPT_DATABASE=true
